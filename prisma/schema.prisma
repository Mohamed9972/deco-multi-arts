// Déco + Multi-Arts — Schéma PostgreSQL (Neon)
// Langue principale : FR. Champs *_fr prêts pour i18n future (ar/en via tables de traduction ou JSON).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  DIRECT     // Achat direct, prix fixe
  ON_REQUEST // Commande avec confirmation
  QUOTATION  // Sur devis uniquement
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  SENT
  ACCEPTED
  REJECTED
}

enum ProjectType {
  VILLA
  HOTEL
  PISCINE
  TERRASSE
  JARDIN
  RESTAURANT
  RESIDENCE
  PROFESSIONNEL
  AUTRE
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  image       String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  featured    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([active, sortOrder])
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  shortDescription String?
  description      String?     @db.Text
  price            Decimal?    @db.Decimal(12, 3)
  currency         String      @default("TND")
  productType      ProductType @default(DIRECT)
  available        Boolean     @default(true)
  featured         Boolean     @default(false)
  sortOrder        Int         @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Détails métier
  material     String?
  dimensions   Json?    // { longueur, largeur, hauteur, hauteurAssise, poids, ... }
  colors       String[] @default([])
  specifications String[] @default([])
  options      Json?    // [{ name, values[] }] ex: couleur, tissu
  images       ProductImage[]
  orderItems   OrderItem[]

  // SEO / affichage
  coverImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([available, featured])
  @@index([productType])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

model Customer {
  id         String  @id @default(cuid())
  fullName   String
  phone      String
  email      String?
  address    String?
  city       String?
  postalCode String?
  notes      String? @db.Text

  orders Order[]
  quotes QuoteRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique // CMD-2026-0042
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12, 3)
  total         Decimal     @db.Decimal(12, 3)
  currency      String      @default("TND")
  notes         String?     @db.Text
  internalNotes String?     @db.Text

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([orderNumber])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  productSlug String?
  image       String?
  unitPrice   Decimal @db.Decimal(12, 3)
  quantity    Int     @default(1)
  options     Json?   // { couleur: "...", ... }
  lineTotal   Decimal @db.Decimal(12, 3)

  @@index([orderId])
}

model QuoteRequest {
  id          String      @id @default(cuid())
  quoteNumber String      @unique // DEV-2026-0012
  status      QuoteStatus @default(NEW)

  fullName String
  phone    String
  email    String?
  company  String?
  city     String?

  projectType ProjectType @default(VILLA)
  productId   String?
  productName String?
  quantity    Int?        @default(1)
  dimensions  String?     @db.Text
  budget      String?
  message     String?     @db.Text
  images      String[]    @default([])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  adminNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([quoteNumber])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
